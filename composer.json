{
  "name": "owebstudio/kirby-clear-cache",
  "description": "This plugin allows you to clean temporary files and folders such as cache, media, .lock and .logins on your website.",
  "type": "kirby-plugin",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby6",
    "kirby-plugin",
    "kirby-cache",
    "cache-clear"
  ],
  "homepage": "https://owebstudio.com",
  "support": {
    "email": "support@owebstudio.com"
  },
  "authors": [
    {
      "name": "oweb studio",
      "email": "contact@owebstudio.com",
      "homepage": "https://owebstudio.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "getkirby/composer-installer": "^1.2"
  },
  "conflict": {
    "getkirby/cms": "<6.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "installer-name": "kirby-cache-clear",
    "kirby": {
      "compatible": "^6.0"
    }
  }
}
