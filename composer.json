{
  "name": "owebstudio/kirby-clear-cache",
  "description": "Clears the caches, media files and other temporary files of your Kirby site from the Panel or the command line.",
  "type": "kirby-plugin",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby6",
    "kirby-plugin",
    "kirby-cache",
    "cache-clear"
  ],
  "homepage": "https://github.com/owebstudio/kirby-clear-cache",
  "support": {
    "issues": "https://github.com/owebstudio/kirby-clear-cache/issues",
    "source": "https://github.com/owebstudio/kirby-clear-cache"
  },
  "authors": [
    {
      "name": "oweb studio",
      "homepage": "https://github.com/owebstudio"
    }
  ],
  "require": {
    "php": "^8.3",
    "getkirby/composer-installer": "^1.2"
  },
  "conflict": {
    "getkirby/cms": "<6.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "installer-name": "kirby-cache-clear",
    "kirby": {
      "compatible": "^6.0"
    }
  }
}
